{
  "name": "crm-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test --test-concurrency=1 tests/api.test.js",
    "check": "node scripts/check-syntax.js",
    "demo": "node scripts/demo.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
